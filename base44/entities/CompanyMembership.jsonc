{
  "name": "CompanyMembership",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "description": "Set once the invited person has an Orqacel account"
    },
    "user_email": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "admin",
        "member"
      ],
      "default": "member"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "declined",
        "expired",
        "revoked",
        "invited"
      ],
      "default": "pending",
      "description": "Only 'active' means an accepted membership and the only state that grants access to company data. 'invited' is kept for rows created before the invitation lifecycle and is treated as pending."
    },
    "invited_by_id": {
      "type": "string",
      "description": "User id of the person who sent the invitation"
    },
    "invited_by_name": {
      "type": "string",
      "description": "Display name of the inviter at the time of the invitation"
    },
    "invited_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the invitation was created"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Invitations expire 7 days after they are created or resent"
    },
    "last_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the invitation email was last sent"
    },
    "responded_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the invitee accepted or declined"
    },
    "token_hash": {
      "type": "string",
      "description": "SHA-256 hash of the single-use invitation token. The raw token only ever appears in the invitation email."
    }
  },
  "required": [
    "company_id",
    "user_email",
    "role"
  ],
  "rls": {
    "read": {
      "data.company_id": {
        "$in": "{{user.data.company_ids}}"
      }
    },
    "create": {
      "created_by_id": "__app_users_may_not_write_memberships__"
    },
    "update": {
      "created_by_id": "__app_users_may_not_write_memberships__"
    },
    "delete": {
      "created_by_id": "__app_users_may_not_write_memberships__"
    }
  }
}