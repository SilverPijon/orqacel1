{
  "name": "Job",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Owning company \u2014 the tenant boundary"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "quotation_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "in_progress",
        "paused",
        "completed",
        "cancelled"
      ],
      "default": "scheduled",
      "description": "Job lifecycle state. 'paused' was added later and means work is temporarily suspended: the job keeps its dates, client, quotation link and price. Existing records only ever hold the original four values, which keep their meaning."
    },
    "pause_reason": {
      "type": "string",
      "description": "Why a paused job is suspended. One of materials, customer, weather, other, or empty when no reason was given. Optional by design."
    },
    "pause_note": {
      "type": "string",
      "description": "Free-text explanation attached to a pause, at most 500 characters. Cleared when the job resumes."
    },
    "paused_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the job was paused. Cleared when it resumes."
    },
    "paused_from_status": {
      "type": "string",
      "description": "The active status the job was paused from (scheduled or in_progress), so resuming returns it where it came from. Cleared when it resumes."
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    },
    "assigned_to_id": {
      "type": "string"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    }
  },
  "required": [
    "company_id",
    "title"
  ],
  "rls": {
    "read": {
      "data.company_id": {
        "$in": "{{user.data.company_ids}}"
      }
    },
    "create": {
      "data.company_id": {
        "$in": "{{user.data.company_ids}}"
      }
    },
    "update": {
      "data.company_id": {
        "$in": "{{user.data.company_ids}}"
      }
    },
    "delete": {
      "data.company_id": {
        "$in": "{{user.data.company_ids}}"
      }
    }
  }
}