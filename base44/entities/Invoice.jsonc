{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Owning company \u2014 the tenant boundary"
    },
    "client_id": {
      "type": "string",
      "description": "Customer the invoice is addressed to, always resolved inside the same company. Kept for navigation only: what the invoice displays comes from the frozen buyer snapshot."
    },
    "client_name": {
      "type": "string",
      "description": "Customer name as it was when the invoice was created, so the invoice keeps reading correctly if the customer is later renamed"
    },
    "number": {
      "type": "string",
      "description": "Company-scoped invoice number, claimed from the company's counter and stored when the invoice is created. Never renumbered, never reused. It is not the payment reference."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "issued",
        "cancelled"
      ],
      "default": "draft",
      "description": "Draft invoices can still be edited. Issued invoices are frozen financial records. Cancelled invoices are kept for history. Transitions are validated and written conditionally on the server."
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "currency": {
      "type": "string",
      "default": "EUR",
      "description": "Currency the invoice was written in, captured from the company at creation and never taken from the company again"
    },
    "line_items": {
      "type": "array",
      "description": "Invoice lines, stored with the invoice. Each line carries its own VAT rate, so one invoice can mix rates.",
      "items": {
        "type": "object",
        "properties": {
          "position": {
            "type": "number",
            "description": "Zero-based order of the line within the invoice"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "vat_rate": {
            "type": "number",
            "description": "VAT percentage for this line"
          },
          "line_total": {
            "type": "number",
            "description": "Net line amount (quantity x unit price), rounded to cents once"
          }
        }
      }
    },
    "vat_rate_set": {
      "type": "boolean",
      "default": false,
      "description": "True when VAT was configured deliberately on this invoice, so an explicitly entered 0% is distinguishable from a rate nobody ever set"
    },
    "vat_summary": {
      "type": "array",
      "description": "VAT grouped by rate: one row per rate used on the invoice, with the net base and the VAT charged on it",
      "items": {
        "type": "object",
        "properties": {
          "rate": {
            "type": "number"
          },
          "base": {
            "type": "number"
          },
          "amount": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "description": "Sum of the net line amounts"
    },
    "vat_amount": {
      "type": "number",
      "description": "Sum of the VAT charged across all rates"
    },
    "total": {
      "type": "number",
      "description": "subtotal + vat_amount"
    },
    "bank_account_id": {
      "type": "string",
      "description": "The company bank account chosen for this invoice. Kept for reference only: what the invoice shows comes from its own payment snapshot. The account is always resolved inside the invoice's own company."
    },
    "payment_reference": {
      "type": "string",
      "description": "Payment reference the customer quotes when paying, generated from the invoice number or entered by hand. It is not the invoice number, it is never regenerated once the invoice is issued, and it never changes by itself."
    },
    "payment_description": {
      "type": "string",
      "description": "Text the customer sees on their bank statement"
    },
    "payment_terms": {
      "type": "string",
      "description": "Payment terms shown with the invoice, for example the payment deadline"
    },
    "service_date": {
      "type": "string",
      "format": "date",
      "description": "Date the service was delivered, when a single date describes it"
    },
    "service_period_start": {
      "type": "string",
      "format": "date",
      "description": "Start of the service period, when a period describes the delivery"
    },
    "service_period_end": {
      "type": "string",
      "format": "date",
      "description": "End of the service period"
    },
    "seller_snapshot": {
      "type": "object",
      "description": "The seller's identity as it was when the invoice was issued, frozen into the invoice. Written by the app's server functions only, and never again after the invoice is issued, so editing the company profile cannot change an invoice that already exists.",
      "properties": {
        "name": {
          "type": "string"
        },
        "legal_name": {
          "type": "string"
        },
        "registration_number": {
          "type": "string"
        },
        "tax_number": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "website": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "country": {
          "type": "string",
          "description": "ISO 3166-1 alpha-2 country code"
        },
        "logo_updated_at": {
          "type": "string",
          "description": "Version marker of the company logo that was current at the time. The logo image itself is not copied per invoice."
        }
      }
    },
    "buyer_snapshot": {
      "type": "object",
      "description": "The customer's identity and billing details as they were when the invoice was issued, frozen into the invoice for the same reason as the seller snapshot.",
      "properties": {
        "name": {
          "type": "string"
        },
        "contact_name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "tax_id": {
          "type": "string"
        }
      }
    },
    "payment_snapshot": {
      "type": "object",
      "description": "How this invoice is paid, frozen into the invoice when it is created and again in the same write that issues it. Written by the app's server functions only, so changing a company bank account later can never change an invoice that already exists.",
      "properties": {
        "account_holder": {
          "type": "string"
        },
        "iban": {
          "type": "string"
        },
        "bank_name": {
          "type": "string"
        },
        "bic": {
          "type": "string"
        },
        "reference": {
          "type": "string",
          "description": "Payment reference frozen with the invoice. Never regenerated after issue."
        },
        "description": {
          "type": "string"
        },
        "terms": {
          "type": "string"
        },
        "service_date": {
          "type": "string"
        },
        "service_period_start": {
          "type": "string"
        },
        "service_period_end": {
          "type": "string"
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the invoice was issued"
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the invoice was cancelled"
    }
  },
  "required": [
    "company_id",
    "number"
  ],
  "rls": {
    "read": {
      "data.company_id": {
        "$in": "{{user.data.company_ids}}"
      }
    },
    "create": {
      "created_by_id": "__app_users_may_not_write_invoices__"
    },
    "update": {
      "created_by_id": "__app_users_may_not_write_invoices__"
    },
    "delete": {
      "created_by_id": "__app_users_may_not_write_invoices__"
    }
  }
}