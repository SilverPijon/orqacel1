{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Company / workspace name"
    },
    "legal_name": {
      "type": "string"
    },
    "registration_number": {
      "type": "string",
      "description": "Optional company registration number, shown on documents when set"
    },
    "tax_number": {
      "type": "string",
      "description": "Optional VAT / tax registration number, shown on documents when set"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "description": "ISO 3166-1 alpha-2 country code"
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "timezone": {
      "type": "string",
      "default": "Europe/Tallinn"
    },
    "default_language": {
      "type": "string",
      "default": "en"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "pro",
        "team"
      ],
      "default": "free"
    },
    "owner_user_id": {
      "type": "string",
      "description": "User id of the company owner"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    },
    "logo_file_uri": {
      "type": "string",
      "description": "Private storage reference to the company logo. Written only by the app's server functions; never exposed to the browser."
    },
    "logo_content_type": {
      "type": "string",
      "description": "Content type verified from the stored file's own bytes: image/png, image/jpeg or image/webp"
    },
    "logo_size": {
      "type": "number",
      "description": "Verified size of the stored logo in bytes, capped at 2097152 (2 MB)"
    },
    "logo_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the logo was last set, replaced or removed"
    },
    "invoice_sequence": {
      "type": "number",
      "default": 0,
      "description": "Highest invoice number claimed for this company. Written only by the app's server functions, so two invoices created at the same moment cannot both take the same number."
    },
    "quotation_sequence": {
      "type": "number",
      "default": 0,
      "description": "Highest quotation number claimed for this company. Written only by the app's server functions, so two quotations created at the same moment cannot both take the same number."
    },
    "default_bank_account_id": {
      "type": "string",
      "description": "The company's preferred bank account, used only to preselect an account on a new invoice. One field, so two accounts can never both be the default. It never limits how many accounts the company may save, and any saved account can still be chosen on an individual invoice. Written only by the app's server functions, which claim it with a conditional update."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "id": {
        "$in": "{{user.data.company_ids}}"
      }
    },
    "create": {
      "created_by_id": "__app_users_may_not_write_companies__"
    },
    "update": {
      "created_by_id": "__app_users_may_not_write_companies__"
    },
    "delete": {
      "created_by_id": "__app_users_may_not_write_companies__"
    }
  }
}