{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Company / workspace name"
    },
    "legal_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "description": "ISO 3166-1 alpha-2 country code"
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "timezone": {
      "type": "string",
      "default": "Europe/Tallinn"
    },
    "default_language": {
      "type": "string",
      "default": "en"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "pro",
        "team"
      ],
      "default": "free"
    },
    "owner_user_id": {
      "type": "string",
      "description": "User id of the company owner"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "id": {
        "$in": "{{user.data.company_ids}}"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}